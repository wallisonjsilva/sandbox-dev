FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git curl ripgrep && rm -rf /var/lib/apt/lists/*
USER node
ENV PATH="/home/node/.local/bin:${PATH}"
RUN curl -fsSL https://antigravity.google/cli/install.sh -o /tmp/agy-install.sh \
    && bash /tmp/agy-install.sh \
    && rm /tmp/agy-install.sh
WORKDIR /workspace
CMD ["agy"]
